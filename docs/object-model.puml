' ========================================
' RELATIONSHIPS
' ========================================

' User to Cart (1:1)
user1 --> cart1 : owns

' Cart to CartItems (1:n)
cart1 --> cartitem1 : contains
cart1 --> cartitem2 : contains

' CartItem to Product (n:1)
cartitem1 ..> prod1 : references
cartitem2 ..> prod2 : references

' User to Wishlist (1:n)
user1 --> wishlist1 : has
user1 --> wishlist2 : has
user2 --> wishlist3 : has

' Wishlist to Product (n:1)
wishlist1 ..> prod3 : refers
wishlist2 ..> prod5 : refers
wishlist3 ..> prod1 : refers

' Category to Products (1:n)
cat1 --> prod1 : categorizes
cat1 --> prod4 : categorizes
cat2 --> prod2 : categorizes
cat2 --> prod3 : categorizes
cat3 --> prod5 : categorizes

' Merchant to Products (1:n)
merchant1 --> prod1 : sells
merchant1 --> prod2 : sells
merchant1 --> prod5 : sells
merchant2 --> prod3 : sells
merchant3 --> prod4 : sells

' Product to Images (1:n)
prod1 --> img1 : has
prod1 --> img2 : has
prod2 --> img3 : has

' User to Orders (1:n)
user1 --> order1 : placed
user2 --> order2 : placed

' Order to OrderItems (1:n)
order1 --> orderitem1 : contains
order1 --> orderitem2 : contains
order2 --> orderitem3 : contains

' OrderItem to Product (n:1)
orderitem1 ..> prod1 : refers
orderitem2 ..> prod2 : refers
orderitem3 ..> prod4 : refers

' Order to MoMoPayment (1:1)
order1 --> momo1 : paid_by

' User to Notifications (1:n)
user1 --> notif1 : receives
user1 --> notif2 : receives
user2 --> notif3 : receives
admin1 --> notif4 : receives

' Order triggers Notifications
order1 ..> notif1 : triggers
momo1 ..> notif2 : triggers

