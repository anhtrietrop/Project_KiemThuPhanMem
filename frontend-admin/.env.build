# Build-time environment variables
# These are used during `npm run build` to prevent NextAuth errors

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=build-time-secret-replace-in-production

# API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# Database URL (not used during build, but required by Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/singitronic_nextjs_db"

# Node Environment
NODE_ENV=production
