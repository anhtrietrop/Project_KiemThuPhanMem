# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# MySQL Database Connection String
# Format: mysql://username:password@host:port/database_name
DATABASE_URL="mysql://root:rootpassword123@localhost:3307/singitronic_nextjs_db"

# Test Database (separate from production)
TEST_DATABASE_URL="mysql://root:rootpassword123@localhost:3307/test_ecommerce_db"

# MySQL Root Password (for Docker)
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=singitronic_nextjs_db

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================

# JWT Secret for signing tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# NextAuth Secret for session encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-change-this-in-production

# NextAuth URLs (adjust for each frontend)
NEXTAUTH_URL_USER=http://localhost:3000
NEXTAUTH_URL_ADMIN=http://localhost:3001

# ==============================================================================
# API CONFIGURATION
# ==============================================================================

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# ==============================================================================
# MOMO PAYMENT INTEGRATION
# ==============================================================================

# MoMo Sandbox Credentials (for testing)
# Get from: https://developers.momo.vn/
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz

# MoMo API Endpoints
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3000/payment/return
MOMO_NOTIFY_URL=http://localhost:3002/api/payment/momo/ipn

# ==============================================================================
# EMAIL SERVICE (OPTIONAL)
# ==============================================================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@singitronic.com

# ==============================================================================
# FILE UPLOAD CONFIGURATION
# ==============================================================================

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ==============================================================================
# RATE LIMITING
# ==============================================================================

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# APPLICATION ENVIRONMENT
# ==============================================================================

NODE_ENV=development

# ==============================================================================
# GITHUB ACTIONS SECRETS REQUIRED
# ==============================================================================
# These secrets must be added to your GitHub repository:
# Repository Settings → Secrets and variables → Actions → New repository secret
#
# Required Secrets:
# - JWT_SECRET (same as above)
# - NEXTAUTH_SECRET (same as above)
# - MOMO_ACCESS_KEY (same as above)
# - MOMO_SECRET_KEY (same as above)
# - MOMO_PARTNER_CODE (same as above)
#
# Optional Deployment Secrets:
# - DEPLOY_HOST (production server IP)
# - DEPLOY_USER (SSH username)
# - DEPLOY_SSH_KEY (SSH private key)
# - DEPLOY_PORT (SSH port, default 22)
# - SLACK_WEBHOOK_URL (for notifications)
# ==============================================================================
