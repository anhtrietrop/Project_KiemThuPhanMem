# =========================
# PHP Project .gitignore
# =========================

# 1️⃣ Bỏ qua file cấu hình nhạy cảm
admin_separated/components/connect.php
.env
.env.local
config.php

# 2️⃣ Bỏ qua thư mục Composer (PHP dependencies)
vendor/

# 3️⃣ Bỏ qua cache, logs, sessions
/storage/
cache/
logs/
*.log

# 4️⃣ Bỏ qua file hệ thống
.DS_Store
Thumbs.db

# 5️⃣ Bỏ qua IDE / Editor configs
.vscode/
.idea/
*.swp
*.swo

# 7️⃣ Bỏ qua backup, temp files
*.bak
*.tmp
*.old
