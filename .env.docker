# ========================================
# E-COMMERCE DOCKER ENVIRONMENT VARIABLES
# ========================================
# File: .env.docker
# Usage: docker compose --env-file .env.docker up

# ========================================
# DATABASE CONFIGURATION (MySQL 8.0)
# ========================================
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=singitronic_nextjs_db

# ⚠️ NOTE: Trong Docker, DATABASE_URL dùng service name 'db' thay vì 'localhost'
DATABASE_URL=mysql://root:rootpassword123@db:3306/singitronic_nextjs_db

# ========================================
# BACKEND CONFIGURATION (Node.js/Express)
# ========================================
NODE_ENV=development
PORT=3002
FRONTEND_USER_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3001

# ========================================
# FRONTEND USER CONFIGURATION (Next.js)
# ========================================
# Client-side API URL (browser calls from host machine)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# Server-side API URL (Docker internal network)
API_INTERNAL_URL=http://backend:3002

# NextAuth Configuration
NEXTAUTH_URL_USER=http://localhost:3000
NEXTAUTH_URL_ADMIN=http://localhost:3001
NEXTAUTH_SECRET=your-secret-key-change-this-in-production-use-openssl-rand-base64-32

# JWT Secret for backend
JWT_SECRET=your-jwt-secret-key-change-in-production

# ========================================
# FRONTEND ADMIN CONFIGURATION (Next.js)
# ========================================
# NEXT_PUBLIC_API_BASE_URL same as user (http://localhost:3002)
# NEXTAUTH_URL for admin: http://localhost:3001
# NEXTAUTH_SECRET same as above

# ========================================
# MOMO PAYMENT INTEGRATION
# ========================================
# Sandbox credentials (for testing)
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_ENVIRONMENT=sandbox
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# Payment callback URLs
# ⚠️ Development: localhost
# ⚠️ Production: thay bằng domain thật (https://yourdomain.com)
MOMO_RETURN_URL=http://localhost:3000/payment/success
MOMO_NOTIFY_URL=http://localhost:3002/api/momo/callback

# ========================================
# OPTIONAL - ADDITIONAL CONFIGS
# ========================================
# JWT Secret (if needed)
# JWT_SECRET=your-jwt-secret-key-change-in-production

# Logging
# LOG_LEVEL=debug

# ========================================
# PRODUCTION NOTES
# ========================================
# 1. Thay đổi MYSQL_ROOT_PASSWORD thành password mạnh
# 2. Thay NEXTAUTH_SECRET bằng: openssl rand -base64 32
# 3. Thay MoMo credentials bằng production keys
# 4. Update MOMO_RETURN_URL và MOMO_NOTIFY_URL với domain thật
# 5. Set NODE_ENV=production
