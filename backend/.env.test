# Test Environment Variables
# Đây là file cấu hình cho môi trường test
# KHÔNG commit file này nếu chứa thông tin nhạy cảm thực tế

# Node Environment
NODE_ENV=test

# Database Configuration (Test Database)
# Sử dụng database riêng cho test, KHÔNG dùng database production
# Docker MySQL credentials (Docker exposes MySQL on port 3307)
DATABASE_URL="mysql://root:rootpassword123@localhost:3307/test_ecommerce_db"
TEST_DATABASE_URL="mysql://root:rootpassword123@localhost:3307/test_ecommerce_db"

# JWT Configuration
JWT_SECRET="test-jwt-secret-key-for-testing-only-do-not-use-in-production"
JWT_EXPIRES_IN="24h"

# MoMo Payment (Mock - không gọi API thật trong test)
MOMO_ACCESS_KEY="test_momo_access_key"
MOMO_SECRET_KEY="test_momo_secret_key"
MOMO_PARTNER_CODE="test_partner_code"
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
MOMO_REDIRECT_URL="http://localhost:3000/payment/callback"
MOMO_IPN_URL="http://localhost:3000/api/payment/momo/ipn"

# Email Service (Mock)
EMAIL_HOST="smtp.test.com"
EMAIL_PORT=587
EMAIL_USER="test@example.com"
EMAIL_PASSWORD="test_password"
EMAIL_FROM="noreply@test.com"

# Upload Configuration
UPLOAD_DIR="./test_uploads"
MAX_FILE_SIZE=5242880

# Rate Limiting (Relaxed for tests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Test Specific
TEST_TIMEOUT=10000
DISABLE_EXTERNAL_CALLS=true
MOCK_SERVICES=true
SKIP_DB=true
