# .env.test - TEST ENVIRONMENT CONFIGURATION
# ============================================
# Sử dụng cấu hình này cho testing
# KHÔNG commit vào git nếu có real credentials

# === ENVIRONMENT ===
NODE_ENV=test
PORT=3002


# === DATABASE ===
# Test database - ISOLATED từ development/production
# ⚠️ VERIFY: MySQL hay PostgreSQL?
# Nếu MySQL:
DATABASE_URL="mysql://root:@localhost:3306/test_ecommerce_db"
TEST_DATABASE_URL="mysql://root:@localhost:3306/test_ecommerce_db"


# === TEST CONFIGURATION ===
# Timeout cho các tests
TEST_TIMEOUT=10000

# Disable external calls (MoMo, Email, etc.)
DISABLE_EXTERNAL_CALLS=true
MOCK_SERVICES=true

# Logging level (verbose for debugging)
LOG_LEVEL=debug

# Skip certain operations
SKIP_EMAIL_VERIFICATION=true
SKIP_PAYMENT_VERIFICATION=true


# === JWT & AUTHENTICATION ===
# Test tokens - đơn giản, an toàn
JWT_SECRET="test-jwt-secret-key-12345678"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="test-refresh-secret-key-12345"
JWT_REFRESH_EXPIRES_IN="7d"


# === PAYMENT GATEWAY (MoMo) ===
# Mock endpoints - KHÔNG gọi API thật
MOMO_PARTNER_CODE="test_momo_partner"
MOMO_ACCESS_KEY="test_access_key"
MOMO_SECRET_KEY="test_secret_key"
MOMO_ENVIRONMENT="test"  # ← Important: use 'test' not 'sandbox'
MOMO_RETURN_URL="http://localhost:3000/payment/callback"
MOMO_NOTIFY_URL="http://localhost:3000/api/payment/notify"


# === EMAIL SERVICE ===
# Mock email service - không gửi email thật
EMAIL_PROVIDER="mock"  # mock | smtp
EMAIL_HOST="smtp.test.local"
EMAIL_PORT=587
EMAIL_USER="test@example.com"
EMAIL_PASSWORD="test_password"
EMAIL_FROM="noreply@test.com"
EMAIL_REPLY_TO="support@test.com"


# === FILE UPLOAD ===
# Test uploads directory
UPLOAD_DIR="./test_uploads"
UPLOAD_MAX_FILE_SIZE=5242880  # 5MB

# Cloudinary (mock)
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME="test_cloud"
CLOUDINARY_API_KEY="test_api_key"
CLOUDINARY_API_SECRET="test_api_secret"


# === RATE LIMITING ===
# Relaxed for tests
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10000


# === CORS & SECURITY ===
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
FRONTEND_USER_URL="http://localhost:3000"
FRONTEND_ADMIN_URL="http://localhost:3001"


# === LOGGING ===
LOG_LEVEL="debug"
LOG_TO_FILE=false


# === EXTERNAL SERVICES ===
# All mocked/disabled
ENABLE_EXTERNAL_API=false
ENABLE_EMAIL_SERVICE=false
ENABLE_SMS_SERVICE=false
ENABLE_PAYMENT_GATEWAY=false
